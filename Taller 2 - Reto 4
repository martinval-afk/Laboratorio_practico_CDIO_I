const int analogInPin = 32;
const int numReadings = 10;
int readings[numReadings];
int readIndex = 0;
long total = 0;
int resistorValue = 0;

void setup() {
  Serial.begin(9600);
  
  for (int i = 0; i < numReadings; i++) {
    readings[i] = 0;
  }
}

void loop() {
  total = total - readings[readIndex];
  readings[readIndex] = analogRead(analogInPin); 
  total = total + readings[readIndex];
  readIndex = (readIndex + 1) % numReadings;
  resistorValue = total / numReadings;

  Serial.print("sensor = ");
  Serial.println(resistorValue);
  
  delay(5);
}
