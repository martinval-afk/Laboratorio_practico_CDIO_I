const int analogInPin = 32; // pin del potenciómetro
int resistorValue = 0; // valor leído del potenciómetro
float voltaje =0.0;
int LED=18;
void setup() {
Serial.begin(9600); // comunicación serial a 9600 bps
pinMode(LED, OUTPUT);
}
void loop() {
resistorValue = analogRead(analogInPin); // lee la entrada analógica
voltaje=(resistorValue*3.3)/4095;
Serial.print("sensor = ");
Serial.println(voltaje);
delay(5); // espera a que el ADC se estabilice
if (voltaje >2.0){
  digitalWrite(LED, HIGH);
}else{
  digitalWrite(LED, LOW);
}
}
